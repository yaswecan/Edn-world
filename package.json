{
  "name": "eden-teacher-twin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14 <23"
  },
  "scripts": {
    "audit:tracking": "node scripts/student-tracking-audit.mjs",
    "test:tracking": "node --import tsx --test tests/student-tracking.test.mjs tests/lesson-transfer.test.mjs tests/documentary-storage.test.mjs",
    "test:tracking:browser": "node --import tsx scripts/student-tracking-browser-check.mjs",
    "preview:quality:v2": "node --import tsx scripts/quality-real.mjs",
    "test:quality:v2": "node --import tsx --test tests/preparation-v2.test.mjs",
    "test:quality:v2:browser": "node --import tsx scripts/preparation-v2-browser.mjs",
    "preview:labs": "node scripts/lab-preview.mjs",
    "dev:chatgpt": "node scripts/chatgpt-local.mjs",
    "dev:lan": "node scripts/chatgpt-local.mjs --lan",
    "test:chatgpt": "node --import tsx --test tests/chatgpt*.test.mjs",
    "test:chatgpt:browser": "node --import tsx scripts/chatgpt-browser-check.mjs",
    "dev": "node --env-file-if-exists=.env.local --import tsx server/index.mjs",
    "preview:student": "node --watch --import tsx scripts/arcade-student-preview.mjs",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.mjs",
    "import": "node --env-file-if-exists=.env.local --import tsx scripts/import.mjs",
    "db:migrate": "node --env-file-if-exists=.env.migration.local scripts/migrate-postgres.mjs",
    "db:export": "node scripts/export-database.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:legacy": "node --test legacy/eden-october/tests/functions.test.mjs legacy/eden-october/tests/logic.test.mjs legacy/eden-october/tests/practice.test.mjs legacy/drive/tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run build:editor && npm run check",
    "test:browser": "node --import tsx scripts/browser-check.mjs",
    "test:console:browser": "node --import tsx scripts/code-runner-browser-check.mjs",
    "demo:lesson": "node scripts/lesson-demo.mjs",
    "demo:serve": "node scripts/lesson-preview-server.mjs",
    "test:visual": "playwright test --config playwright.lesson.config.mjs",
    "test:visual:update": "playwright test --config playwright.lesson.config.mjs --update-snapshots",
    "preview:quality": "node --import tsx scripts/quality-preview.mjs",
    "test:quality": "node --import tsx --test tests/pedagogy.test.mjs tests/pedagogy-api.test.mjs",
    "test:quality:browser": "node --import tsx scripts/quality-browser-check.mjs",
    "test:quality:dom": "node --import tsx scripts/quality-dom-check.mjs",
    "preview:documentary": "node --import tsx scripts/documentary-preview.mjs",
    "test:documentary": "node --import tsx --test tests/documentary-storage.test.mjs",
    "test:documentary:browser": "node --import tsx scripts/documentary-browser-check.mjs",
    "test:documentary:search": "node --import tsx scripts/documentary-search-check.mjs",
    "preview:exploration": "node --import tsx scripts/exploration-preview.mjs",
    "test:exploration": "node --import tsx --test tests/exploration*.test.mjs",
    "test:exploration:browser": "node --import tsx scripts/exploration-browser-check.mjs",
    "test:transfers": "node --import tsx --test tests/lesson-transfer.test.mjs",
    "test:transfers:browser": "node --import tsx scripts/lesson-transfer-browser-check.mjs",
    "test:transfers:labs": "node --import tsx scripts/lesson-transfer-labs-check.mjs",
    "build:editor": "node scripts/build-lesson-editor.mjs",
    "test:editor": "node --import tsx --test tests/lesson-editor.test.mjs",
    "test:editor:browser": "node --import tsx scripts/lesson-editor-browser-check.mjs",
    "test:editor:labs": "node --import tsx scripts/lesson-editor-labs-check.mjs",
    "test:tracking:v2": "node --import tsx --test tests/competency-v2.test.mjs tests/default-framework.test.mjs",
    "test:tracking:v2:browser": "node --import tsx scripts/competency-v2-browser-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/view": "6.43.14",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@xterm/xterm": "5.5.0",
    "ajv": "8.20.0",
    "archiver": "7.0.1",
    "codemirror": "6.0.2",
    "css-tree": "^3.1.0",
    "esbuild": "0.28.2",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "googleapis": "156.0.0",
    "jszip": "3.10.1",
    "oauth4webapi": "3.8.2",
    "parse5": "^7.3.0",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "pptxgenjs": "4.0.1",
    "proper-lockfile": "4.1.2",
    "sax": "1.4.1",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.3"
    }
  }
}
