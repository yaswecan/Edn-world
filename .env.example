# Local startup needs no external service. Production requires PostgreSQL.
PORT=3000
HOST=127.0.0.1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/eden?sslmode=require
# EDEN_DB_PATH=.data/eden.sqlite

# Optional bootstrap. Otherwise create the teacher account on the local setup screen.
# EDEN_TEACHER_USERNAME=professeur
# EDEN_TEACHER_PASSWORD=choose-a-unique-password-of-at-least-12-characters

# Optional: enables structured lesson generation with the Responses API.
# Select a model available to your account that supports structured outputs.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Optional: reuses Drive Distributor's service-account / Workspace authentication.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_IMPERSONATED_USER=
# GOOGLE_DRIVE_ELEVES_FOLDER_ID=

# Local content-addressed artifacts (back up together with SQLite).
# EDEN_ARTIFACT_PATH=.data/artifacts
# Optional teacher corpus destination, separate from student folders.
# GOOGLE_DRIVE_TEACHER_FOLDER_ID=

# Optional rubric pre-correction (teacher-triggered, confidence threshold 0.85).
# OPENAI_GRADING_MODEL=
# Serverless worker authentication. Configure the same secret on the host.
# CRON_SECRET=

# Optional S3-compatible content-addressed object storage.
# Recommended for serverless production to keep binary exports out of PostgreSQL.
# EDEN_S3_BUCKET=
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EDEN_S3_ENDPOINT=https://your-s3-compatible-endpoint

# World Arcade (disabled by default). Does not enable public registration.
EDEN_WORLD_ARCADE=0

# Quality pipeline: enabled by default in development, opt-in in production.
# No production deployment is performed by the preparation tools.
# EDEN_QUALITY_PIPELINE=1
# Explicit model available to your API account (no silent downgrade).
# Profiles verified in server/pedagogy/provider.mjs. No automatic selection from a subscription.
# EDEN_AI_MODEL=gpt-6.1-sol
# EDEN_AI_EFFORT=high
# EDEN_AI_DESIGN_MODEL=gpt-6.1-sol
# EDEN_AI_WRITE_MODEL=gpt-6.1-sol
# EDEN_AI_REVIEW_MODEL=gpt-6.1-sol
# EDEN_AI_REPAIR_MODEL=gpt-6.1-sol
# EDEN_AI_REVIEW_EFFORT=xhigh
# EDEN_AI_MAX_OUTPUT_TOKENS=24000
# EDEN_AI_MAX_CALLS=24
# EDEN_AI_MAX_SESSION_USD=6
# EDEN_AI_MAX_CALL_USD=1.5
# EDEN_AI_MAX_SESSION_MINUTES=30
# Call timeout: API default 180 s (max 240); ChatGPT plan default 600 s (max 1200).
# Every call is also bounded by the preparation's remaining total time.
# EDEN_AI_CALL_TIMEOUT_SECONDS=180
# EDEN_AI_MAX_REWRITES=3
# EDEN_DIAGNOSTIC_MINUTES=8
# URL ingestion is denied until exact HTTPS hostnames are configured.
# EDEN_SOURCE_HOSTS=developer.mozilla.org,git-scm.com
# EDEN_QUALITY_EVIDENCE_PATH=.data/quality-evidence
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chromium
# Dedicated disposable lab VM, never the application host.
# EDEN_LAB_URL=http://127.0.0.1:4182
# EDEN_LAB_TOKEN=replace-with-a-long-random-secret
# Expected immutable image digests; must match the dedicated broker.
# EDEN_LAB_SHELL_IMAGE=sha256:64-hex-characters
# EDEN_LAB_DOM_IMAGE=sha256:64-hex-characters
# Optional comparison harness; global spend reservation cap, not a per-call target.
# EDEN_COMPARISON_MODEL=gpt-6.1-sol
# EDEN_COMPARISON_MAX_USD=6

# ChatGPT personal runtime: npm run dev:chatgpt (never loads .env.local).
# Put personal overrides in .env.chatgpt.local; see docs/chatgpt/README.md.
# EDEN_CHATGPT_PORT=4181
# The launcher fixes HOST=127.0.0.1, a separate SQLite database, credential vault,
# EDEN_CHATGPT_MODE=local and EDEN_AI_WORKER_EXTERNAL=1.
# Never set local credentials or a dynamic client ID in Vercel variables.
# Hosted SIWC remains unavailable pending confirmed partner access and its contract.

# Optional API Responses background retrieval. Unsupported for ChatGPT plan access.
EDEN_AI_BACKGROUND=0
# Optional private Git projection. Dedicated bare repository, never the app repo.
# DB/object storage remain authoritative; unset leaves archive events pending.
EDEN_ARCHIVE_REPOSITORY=
EDEN_ARCHIVE_ID=private-pedagogy
# Explicit optional destination: absolute bare-repo path, HTTPS or SSH URL.
EDEN_ARCHIVE_REMOTE=
