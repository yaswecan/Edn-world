# Copier en .env.local pour npm run dev. Ne jamais committer .env.local.
# Dans Vercel : Settings > Environment Variables. Valeurs serveur uniquement.
# Copier la chaîne de connexion POSTGRES complète depuis le bouton Connect de Neon.
# Exemple de FORME uniquement : postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# 20 caractères minimum. Générer les secrets : npm run secrets
TEACHER_PASSWORD=
# 8 caractères minimum, distinct du mot de passe professeur.
CLASS_CODE=
# 32 caractères minimum. Authentifie la purge quotidienne par Vercel Cron.
CRON_SECRET=
# Facultatif : libellé de classe stable, ne pas changer après lancement sans le vouloir.
CLASS_ID=a1-logique-261001
CLASS_LABEL="EDEN · Logique · 1 octobre 2026"
RETENTION_DAYS=30
# Facultatif : vide pour utiliser automatiquement le domaine du déploiement.
# Si renseigné, origine HTTPS exacte, sans / final ni chemin.
PUBLIC_ORIGIN=
# Réservé aux tests réels sur une branche Neon de TEST indépendante.
# Ne pas utiliser la base de la classe ici.
TEST_DATABASE_URL=
TEST_ALLOW_DB_WRITES=0
