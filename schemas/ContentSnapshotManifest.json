{
  "$id": "EDEN.ContentSnapshotManifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "event",
    "eventId",
    "subject",
    "acceptedAt",
    "versions",
    "files",
    "external"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object"
    },
    "acceptedAt": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "object"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "audience": {
            "enum": [
              "student",
              "teacher",
              "private"
            ]
          }
        }
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "audience": {
            "enum": [
              "student",
              "teacher",
              "private"
            ]
          }
        }
      }
    }
  }
}
