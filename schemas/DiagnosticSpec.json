{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "baseline",
        "previous_lesson"
      ]
    },
    "sourceLessonRunId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceLessonVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration": {
      "type": "integer",
      "minimum": 5,
      "maximum": 20
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "type": {
            "enum": [
              "WriteResponse",
              "CodeEditor",
              "Quiz",
              "Matching",
              "FillBlank",
              "Terminal",
              "Preview",
              "Reflection",
              "Submission",
              "CodeStationLauncher",
              "TruthTable",
              "CircuitExercise",
              "DragDrop",
              "Console",
              "TestRunner",
              "FileExplorer",
              "MasteryCheck",
              "Simulator",
              "Blackboard"
            ]
          },
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedEvidence": {
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "required": {
            "type": "boolean"
          },
          "correctionMode": {
            "enum": [
              "manual",
              "exact",
              "javascript",
              "structured",
              "html",
              "css",
              "sql",
              "rubric",
              "none"
            ]
          },
          "expectedAnswer": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "starter": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "invoke": {
                  "type": "string"
                },
                "argsJSON": {
                  "type": "string"
                },
                "expectedJSON": {
                  "type": "string"
                }
              },
              "required": [
                "invoke",
                "argsJSON",
                "expectedJSON"
              ],
              "additionalProperties": false
            }
          },
          "workshop": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": {
                "enum": [
                  "javascript",
                  "html",
                  "css",
                  "sql",
                  "text"
                ]
              },
              "document": {
                "type": "string"
              },
              "style": {
                "type": "string"
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prediction": {
                "type": "string"
              },
              "board": {
                "enum": [
                  "01-parent",
                  "02-axes",
                  "03-espace-libre",
                  "04-aligner",
                  "05-espaces",
                  "06-une-regle",
                  "07-deboguer",
                  "08-refaire"
                ]
              },
              "profile": {
                "enum": [
                  "html-css",
                  "algorithm",
                  "dom",
                  "shell-git",
                  "concepts"
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "content"
                  ],
                  "additionalProperties": false
                }
              },
              "visual": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "alt": {
                    "type": "string"
                  },
                  "width": {
                    "type": "number"
                  },
                  "height": {
                    "type": "number"
                  }
                },
                "required": [
                  "id",
                  "alt",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            }
          },
          "publicTests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "invoke": {
                  "type": "string"
                },
                "argsJSON": {
                  "type": "string"
                },
                "expectedJSON": {
                  "type": "string"
                }
              },
              "required": [
                "invoke",
                "argsJSON",
                "expectedJSON"
              ],
              "additionalProperties": false
            },
            "maxItems": 20
          },
          "validationVariants": {
            "type": "object",
            "properties": {
              "wrong": {
                "type": "string"
              },
              "wrongExplanation": {
                "type": "string"
              },
              "alternative": {
                "type": "string"
              }
            },
            "required": [
              "wrong",
              "wrongExplanation",
              "alternative"
            ],
            "additionalProperties": false
          },
          "observation": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "output": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "code",
              "output"
            ],
            "additionalProperties": false
          },
          "richText": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instruction": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "doc"
                  },
                  "content": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              },
              "objective": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "doc"
                  },
                  "content": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              },
              "expectedEvidence": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "doc"
                  },
                  "content": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              },
              "reference": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "doc"
                  },
                  "content": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "instruction",
          "objective",
          "skills",
          "expectedEvidence",
          "duration",
          "required",
          "correctionMode",
          "expectedAnswer",
          "reference",
          "starter",
          "options",
          "tests"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 100
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "max": {
            "type": "number",
            "minimum": 0
          },
          "a1": {
            "type": "number"
          },
          "a2": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "criterion",
          "taskId",
          "label",
          "max",
          "a1",
          "a2"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "policyVersion": {
      "type": "string"
    },
    "expectations": {
      "type": "object",
      "properties": {
        "a1": {
          "type": "string"
        },
        "a2": {
          "type": "string"
        }
      },
      "required": [
        "a1",
        "a2"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "kind",
    "sourceLessonRunId",
    "sourceLessonVersion",
    "duration",
    "criteria",
    "tasks",
    "rubric"
  ],
  "additionalProperties": false
}
