  "rocket": {
    "title": "ROCKET//LAUNCH",
    "icon": "🚀",
    "tagline": "Transformer les maths en trajectoires.",
    "desc": "Formules, séquences, boucles et simulation pour préparer un lancement.",
    "colors": [
      "#3e213a",
      "#24132e"
    ],
    "resources": [
      "BC05-C1-4",
      "BC05-C1-3",
      "BC05-C2-2"
    ],
    "requires": "bunker",
    "missions": [
      {
        "id": "pythagore",
        "title": "La diagonale oubliée",
        "skill": "Maths → code",
        "resources": [
          "BC05-C2-1"
        ],
        "brief": "Calcule la distance directe entre deux positions à partir de dx et dy.",
        "files": {
          "distance.js": "function distance(dx, dy) {\n  return Math.sqrt(dx * dx + dy * dy);\n}"
        },
        "scenarios": [
          {
            "name": "30 / 40",
            "input": {
              "dx": 30,
              "dy": 40
            },
            "expected": 50
          },
          {
            "name": "6 / 8",
            "input": {
              "dx": 6,
              "dy": 8
            },
            "expected": 10
          },
          {
            "name": "coordonnées négatives",
            "input": {
              "dx": -9,
              "dy": 12
            },
            "expected": 15
          }
        ],
        "validator": "distance"
      },
      {
        "id": "sequence",
        "title": "Séquence de lancement",
        "skill": "Ordre logique",
        "resources": [
          "BC05-C2-2"
        ],
        "brief": "Réorganise les étapes de lancement dans l’ordre sûr.",
        "files": {
          "sequence.js": "const steps = [\"cooling\", \"pressure\", \"ignition\", \"release\"];\nreturn steps;"
        },
        "scenarios": [
          {
            "name": "Protocole",
            "input": {},
            "expected": [
              "cooling",
              "pressure",
              "ignition",
              "release"
            ]
          }
        ],
        "validator": "returnArray"
      },
      {
        "id": "countdown",
        "title": "Compte à rebours",
        "skill": "Boucle",
        "resources": [
          "BC05-C1-3"
        ],
        "brief": "Génère le compte à rebours sans écrire chaque nombre à la main.",
        "files": {
          "countdown.js": "function countdown(from) {\n  const out = [];\n  for (let i = from; i >= 0; i--) out.push(i);\n  return out;\n}"
        },
        "scenarios": [
          {
            "name": "5 secondes",
            "input": {
              "from": 5
            },
            "expected": [
              5,
              4,
              3,
              2,
              1,
              0
            ]
          },
          {
            "name": "2 secondes",
            "input": {
              "from": 2
            },
            "expected": [
              2,
              1,
              0
            ]
          }
        ],
        "validator": "countdown"
      },
      {
        "id": "rocket-final",
        "title": "Évaluation · Contrôleur de lancement",
        "skill": "Production",
        "resources": [
          "BC05-C1-2",
          "BC05-C1-3",
          "BC05-C2-2"
        ],
        "brief": "Crée launchReport : distance, checks valides et autorisation de lancement.",
        "files": {
          "launch.js": "function launchReport(data) {\n  // data={dx,dy,checks:[true,false,...]}\n  return { distance: 0, ready: false, passedChecks: 0 };\n}"
        },
        "scenarios": [
          {
            "name": "Lancement prêt",
            "input": {
              "data": {
                "dx": 30,
                "dy": 40,
                "checks": [
                  true,
                  true,
                  true
                ]
              }
            },
            "expected": {
              "distance": 50,
              "ready": true,
              "passedChecks": 3
            }
          },
          {
            "name": "Check manquant",
            "input": {
              "data": {
                "dx": 6,
                "dy": 8,
                "checks": [
                  true,
                  false,
                  true
                ]
              }
            },
            "expected": {
              "distance": 10,
              "ready": false,
              "passedChecks": 2
            }
          }
        ],
        "validator": "rocketFinal",
        "final": true
      }
    ]
  },
