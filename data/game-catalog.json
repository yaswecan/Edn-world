                {
                  "active": true
                }
              ]
            },
            "expected": 2
          }
        ],
        "validator": "activeCount"
      },
      {
        "id": "energy",
        "title": "Décision énergie",
        "skill": "Condition",
        "resources": [
          "BC05-C1-2"
        ],
        "brief": "Un drone doit recharger si sa batterie est inférieure à 40.",
        "files": {
          "energy.js": "function action(drone) {\n  return drone.battery < 40 ? \"RECHARGE\" : \"READY\";\n}"
        },
        "scenarios": [
          {
            "name": "Batterie faible",
            "input": {
              "drone": {
