          "BC05-C1-3",
          "BCT02-C1-1"
        ],
        "brief": "Un même programme doit activer tous les modules, quel que soit leur nombre.",
        "files": {
          "motors.js": "const started = [];\nfor (let i = 0; i < nombreModules; i++) {\n  started.push(i);\n}\nreturn started;"
        },
        "scenarios": [
          {
            "name": "4 modules",
            "input": {
              "nombreModules": 4
            },
            "expected": [
              0,
              1,
              2,
              3
            ]
          },
          {
            "name": "6 modules",
