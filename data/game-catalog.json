          "style.css": ".access-card { width: 320px; padding: 16px; border: 2px solid #29465c; border-radius: 16px; }\n.actions { display: flex; gap: 12px; }"
        },
        "scenarios": [
          {
            "name": "Carte standard",
            "input": {},
            "expected": true
          }
        ],
        "validator": "card"
      },
      {
        "id": "station-final",
        "title": "Évaluation · Réparer la station",
        "skill": "Production",
        "resources": [
          "BC05-C2-2",
          "BC05-C1-2",
          "BC05-C1-3",
          "BC05-C1-4"
        ],
        "brief": "Écris un petit programme de réparation : vérifier la batterie, refroidir les cellules chaudes et préparer tous les modules.",
        "files": {
          "repair.js": "function repair(config) {\n  const report = { batteryOk: false, cooled: 0, modules: [] };\n  // À compléter\n  return report;\n}"
        },
        "scenarios": [
          {
            "name": "Station A",
            "input": {
              "battery": 90,
              "temps": [
                65,
                82,
                75
              ],
              "modules": 4
            },
            "expected": {
              "batteryOk": true,
              "cooled": 2,
              "modules": [
                0,
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "Station B",
            "input": {
              "battery": 70,
              "temps": [
                40,
                60
              ],
              "modules": 0
            },
            "expected": {
              "batteryOk": false,
              "cooled": 0,
              "modules": []
            }
          }
        ],
        "validator": "stationFinal",
        "final": true
      }
    ]
  },
