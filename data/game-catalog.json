        "skill": "Boucle + objets",
        "resources": [
          "BC05-C1-3",
          "BC05-C1-6"
        ],
        "brief": "Attribue une position croissante aux drones actifs uniquement.",
        "files": {
          "formation.js": "function formation(drones) {\n  const out=[]; let slot=0;\n  for (const d of drones) if (d.active) out.push({id:d.id,slot:slot++});\n  return out;\n}"
        },
        "scenarios": [
          {
            "name": "Formation A",
            "input": {
              "drones": [
                {
                  "id": "A",
                  "active": true
                },
                {
                  "id": "B",
                  "active": false
                },
                {
                  "id": "C",
                  "active": true
                }
              ]
            },
            "expected": [
              {
                "id": "A",
                "slot": 0
              },
              {
                "id": "C",
                "slot": 1
              }
            ]
          }
        ],
        "validator": "formation"
      },
