              "nombreModules": 6
            },
            "expected": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          },
          {
            "name": "0 module",
            "input": {
              "nombreModules": 0
            },
            "expected": []
          }
        ],
        "validator": "motors"
      },
      {
