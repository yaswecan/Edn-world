          "stable_opaque_player_key_asc"
        ],
        "displayCompetitionRank": true,
        "topFiveRemainsFiveRows": true
      }
    },
    "rewards": {
      "authority": "host_server_validator",
      "noAwardOnClientFinishedFlag": true,
      "deduplicateByStableBusinessAwardKey": true,
      "transactionOrEquivalentRequired": true,
      "clientIdempotencyKeyAloneIsInsufficient": true,
      "noDemoToProductionProgressMigration": true
