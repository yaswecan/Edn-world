  "policies": {
    "configurationStatus": "proposed_safe_defaults_map_to_existing_host_policy",
    "identity": {
      "reuseHostAuth": true,
      "duplicateSchoolAccounts": false,
      "publicRoleGrantedBy": "server",
      "clientRoleFieldAllowed": false,
      "passwordPolicySource": "host_authentication_configuration",
      "persistPasswordOrEmailInLocalStorage": false
    },
    "privacy": {
      "publicSchoolDirectory": false,
      "publicProfileDefault": "private",
      "publicStudentParticipationDefault": false,
      "guestDirectoryAccessDefault": false,
      "showPresenceDefault": false,
      "allowedPublicProfileFields": [
        "publicId",
        "handle",
        "avatarId",
        "grade",
        "approvedPublicAchievements"
      ],
      "disallowedPublicProfileFields": [
        "email",
        "fullName",
        "dateOfBirth",
        "className",
        "classId",
        "schoolName",
        "schoolId",
        "schoolMarks",
        "lastSeenAt"
      ],
      "publicOpeningRequiresApprovedMinorPolicy": true
    },
    "players": {
      "serverScopeFiltering": true,
      "serverPagination": true,
      "suggestedPageSize": 24,
      "countOnlyVisiblePlayers": true,
      "neverImportDemoPlayers": true
    },
    "leaderboard": {
      "maxRows": 5,
      "clientAndServerLimit": true,
      "returnPaginationCursor": false,
      "personalPositionOutsideTopFive": "private_separate_summary",
      "metricsSource": "approved_host_metric",
      "combineGamesOnlyWithApprovedCommonMetric": true,
      "clientAwardEventsTrusted": false,
      "demoXpAllowed": false,
      "fallbackScoresAllowed": false,
      "periodsOfferedOnlyIfSupportedByHost": true,
      "proposedPeriods": [
        "week",
        "month",
        "all_time"
      ],
      "proposedTimeZoneIfMissing": "Europe/Paris",
      "newTimeZoneRequiresValidation": true,
      "tiePresentationProposal": {
